{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/__l5e/assets-v1/:id/safari-7s-2026.jpg",
      "destination": "/images/safari-7s-2026.jpg"
    },
    {
      "source": "/__l5e/assets-v1/:id/tikohub-logo.png",
      "destination": "/images/tikohub-logo.png"
    },
    {
      "source": "/__l5e/assets-v1/:id/lionesses-away.jpg",
      "destination": "/images/lionesses-away.jpg"
    },
    {
      "source": "/__l5e/assets-v1/:id/lionesses-home.jpg",
      "destination": "/images/lionesses-home.jpg"
    },
    {
      "source": "/__l5e/assets-v1/:id/shujaa-away.jpg",
      "destination": "/images/shujaa-away.jpg"
    },
    {
      "source": "/__l5e/assets-v1/:id/shujaa-home.jpg",
      "destination": "/images/shujaa-home.jpg"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
